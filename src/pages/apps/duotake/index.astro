---
import AppTemplate from "../../../components/app/AppTemplate.astro";

const title = "Dual Camera: DuoTake";
const appId = "id6761627384";
const appStoreUrl = "https://apps.apple.com/us/app/dual-camera-duotake/id6761627384";
const appName = "DuoTake";
const pageTitle = "Dual Camera: DuoTake";
const description =
    "Split screen & teleprompter";
const favicon = "apps/duotake/favicon.png";
const appIcon = "duotake/app-icon.png";
const socialImage = "duotake/duotake-share-en.jpg";
const socialImageAlt = "DuoTake app icon with reaction dual cam app summary.";

const metas = [{ name: "apple-itunes-app", content: "app-id=6761627384" }];
const primaryKeyword = "reaction dual cam app";
const secondaryKeywords = [
    "reaction video app",
    "photo and video capture",
    "front and back camera",
    "teleprompter app",
    "scripted video recording",
    "content creator app",
    "record video",
    "TikTok Reels Shorts",
];

const screenshots = [
    {
        url: {
            en: "duotake/screenshots/en/frame-1.png",
            ptBr: "duotake/screenshots/ptBR/frame-1.png",
        },
        alt: "DuoTake Cutout preview showing an automatic cutout reaction over a full-screen camera view.",
        caption: "Use Cutout to keep your reaction clean with automatic background removal.",
    },
    {
        url: {
            en: "duotake/screenshots/en/frame-2.png",
            ptBr: "duotake/screenshots/ptBR/frame-2.png",
        },
        alt: "DuoTake dual-camera recording screen showing a mountain view with a selfie reaction overlay.",
        caption: "Show the moment and your expression together in a single recording.",
    },
    {
        url: {
            en: "duotake/screenshots/en/frame-3.png",
            ptBr: "duotake/screenshots/ptBR/frame-3.png",
        },
        alt: "DuoTake Cover layout showing a full-screen picnic scene with a group selfie camera overlaid.",
        caption: "Use Cover to highlight one camera full-screen while keeping the other view overlaid.",
    },
    {
        url: {
            en: "duotake/screenshots/en/frame-4.png",
            ptBr: "duotake/screenshots/ptBR/frame-4.png",
        },
        alt: "DuoTake Teleprompter recording screen with a script overlay in front of the camera view.",
        caption: "Follow your script on screen with the premium Teleprompter while recording.",
    },
    {
        url: {
            en: "duotake/screenshots/en/frame-5.png",
            ptBr: "duotake/screenshots/ptBR/frame-5.png",
        },
        alt: "DuoTake dual reaction camera layout recording front and rear cameras at the same time.",
        caption: "Record front and rear cameras together in a dual-view creator layout.",
    },
    {
        url: {
            en: "duotake/screenshots/en/frame-6.png",
            ptBr: "duotake/screenshots/ptBR/frame-6.png",
        },
        alt: "DuoTake live reaction recording at a stadium with a reaction camera overlay.",
        caption: "Appear alongside the moment with a live reaction overlay.",
    },
];

const facts = [
    { label: "Platform", value: "iPhone" },
    { label: "Version", value: "1.3.1" },
    { label: "Best for", value: "Creators, reviews, reacts" },
    { label: "Requires", value: "iOS 26.6 or later" },
];

const features = [
    {
        title: "Photos and videos with two views",
        description: "Capture the scene and your reaction together using both iPhone cameras.",
    },
    {
        title: "React to imported content with Pro",
        description: "Replace the rear view with an image, video or web page captured from an HTTPS URL.",
    },
    {
        title: "Four layout styles",
        description: "Compose your take with PiP, Cover, vertical or horizontal split screen, or Cutout.",
    },
    {
        title: "Premium Teleprompter",
        description: "Keep a script visible during video capture.",
    },
    {
        title: "Local gallery",
        description: "Review your captures on your device, export to Photos or choose a destination in the system share sheet.",
    },
    {
        title: "Free and Pro",
        description: "Record up to 60 seconds for free. Pro adds longer recordings, automatic saving to Photos and sharing without the temporary watermark.",
    },
];

const useCases = [
    {
        title: "Record everything. Including your reaction.",
        description: "DuoTake records with the front and rear cameras at once, showing what is happening and how you react in a single video.",
    },
    {
        title: "Stay on script",
        description: "Use the premium Teleprompter for presentations, reviews, tutorials, vlogs, and scripted reactions without looking away from the camera.",
    },
];

const faq = [
    {
        question: "What is DuoTake?",
        answer: "DuoTake is a dual-camera video app for recording with the front and rear cameras at the same time. It helps you capture the moment, your voice, your script, and your reaction in one composed video.",
    },
    {
        question: "Who is DuoTake for?",
        answer: "DuoTake is made for creators, product reviews, reactions, commentary, tutorials, vlogs, events, travel videos, and anyone who wants to show the moment and their reaction at the same time.",
    },
    {
        question: "Can I react to images, videos or web pages?",
        answer: "Yes. Pro lets you import an image, video or HTTPS web page to use in place of the rear-camera view. Only use content you have permission to record and share.",
    },
    {
        question: "Does DuoTake support background removal?",
        answer: "Yes. DuoTake includes Cutout background removal to help keep your reaction clean, focused, and easier to place over the moment you are recording.",
    },
    {
        question: "Does DuoTake include a Teleprompter?",
        answer: "Yes. Premium users can use the Teleprompter to write or paste a script, follow the text during capture, and record presentations, reviews, tutorials, vlogs, and reactions more naturally.",
    },
    {
        question: "Does DuoTake work offline?",
        answer: "Core camera capture and local media processing work on your device. Loading a web page, purchases and purchase restoration need an internet connection. Saving to Photos requires permission.",
    },
    {
        question: "How do I restore my purchase?",
        answer: "If you already unlocked DuoTake premium features, tap <em>Restore Purchases</em> and the app will ask Apple to verify your previous purchase using the same Apple ID — with no extra charge.",
    },
];
---

<AppTemplate
    title={title}
    appId={appId}
    appStoreUrl={appStoreUrl}
    appName={appName}
    pageTitle={pageTitle}
    metas={metas}
    favicon={favicon}
    appIcon={appIcon}
    socialImage={socialImage}
    socialImageAlt={socialImageAlt}
    description={description}
    screenshots={screenshots}
    faq={faq}
    facts={facts}
    features={features}
    useCases={useCases}
    primaryKeyword={primaryKeyword}
    secondaryKeywords={secondaryKeywords}
    lang="en"
    operatingSystem="iOS 26.6 or later"
    applicationCategory="MultimediaApplication"
/>
