---
import AppTemplate from "../../../components/app/AppTemplate.astro";

const appName = "GiggleFace";
const title = "GiggleFace - Real-Time Face Masks";
const pageTitle = "GiggleFace | Offline Real-Time Face Masks for iPhone and Mac";
const description =
    "Create and adjust custom face masks from any image, apply them live with the front camera, record at 60 fps with audio, and use GiggleFace as a virtual camera on Mac with on-device processing.";
const favicon = "/apps/giggleface/favicon.png";
const appIcon = "/apps/giggleface/app-icon.jpg";
const socialImage = "/social/apps/giggleface-share-en.jpg";
const socialImageAlt = "GiggleFace real-time face mask preview with glowing facial tracking lines.";
const testFlightUrl = "https://testflight.apple.com/join/GjXwReZf";

const screenshots = [
    "Reserved space for the GiggleFace mask camera screenshot.",
    "Reserved space for the GiggleFace custom mask editor screenshot.",
    "Reserved space for the GiggleFace recording screenshot.",
    "Reserved space for the GiggleFace macOS virtual camera screenshot.",
].map((alt) => ({ placeholder: true as const, alt }));

const facts = [
    { label: "Platforms", value: "iPhone + Mac" },
    { label: "Requires", value: "iOS 26+ · macOS 26+" },
    { label: "Privacy", value: "On-device processing" },
    { label: "Premium", value: "One-time purchase" },
];

const features = [
    {
        title: "Custom masks from any image",
        description: "Premium users can import a photo from their library or share an image from another app, then turn it into a personal face mask.",
    },
    {
        title: "Live, on-device masking",
        description: "Apply masks to the front camera in real time while image and facial landmark processing stays on your device.",
    },
    {
        title: "Simple, dynamic editor",
        description: "Adjust the mask position, scale, and fit with a focused editor designed for quick experimentation.",
    },
    {
        title: "Share masks with friends",
        description: "Export a mask file and choose how to send it through the system Share Sheet, without uploading it to a GiggleFace server.",
    },
    {
        title: "60 fps recording with audio",
        description: "Record playful masked videos with sound at up to 60 frames per second on supported devices and configurations.",
    },
    {
        title: "Virtual camera for Mac",
        description: "Select GiggleFace as a camera in Google Meet, Microsoft Teams, FaceTime, and other macOS apps that accept virtual camera input.",
    },
    {
        title: "No subscriptions",
        description: "GiggleFace Premium is a single non-consumable purchase that unlocks custom mask creation and all supported Premium features.",
    },
];

const useCases = [
    {
        title: "Make video calls more fun",
        description: "Bring a playful mask to work calls, chats with friends, and family moments through the macOS virtual camera.",
    },
    {
        title: "Record a new character",
        description: "Create a look from an image, fine-tune it, and record a smooth clip with audio directly on your device.",
    },
    {
        title: "Create and share together",
        description: "Exchange mask files through the apps you already use and keep building a collection with friends.",
    },
];

const faq = [
    {
        question: "What is GiggleFace?",
        answer: "GiggleFace is an iPhone and Mac app that applies image-based face masks to the front camera in real time. You can adjust masks, record videos, and use the processed feed as a virtual camera on macOS.",
    },
    {
        question: "Does GiggleFace work offline?",
        answer: "Yes. Camera, mask, facial landmark, and recording processing run locally on your device. Internet access can still be required for TestFlight, purchases and restoration, importing an online image through another service, anonymous diagnostics, sharing through online apps, and video calls.",
    },
    {
        question: "How do I create a custom mask?",
        answer: "With <strong>GiggleFace Premium</strong>, choose an image from your photo library or share an image from another app into GiggleFace. Then use the editor to adjust its position, scale, and fit.",
    },
    {
        question: "Can I share masks with friends?",
        answer: "Yes. GiggleFace exports a mask file and opens the system Share Sheet so you can choose a compatible messaging, storage, or sharing app. GiggleFace does not host the file on a developer-operated sharing server.",
    },
    {
        question: "Is GiggleFace Premium a subscription?",
        answer: "No. The app is free to download, and Premium is available as a one-time purchase with no recurring subscription.",
    },
    {
        question: "Which Mac video apps support GiggleFace?",
        answer: "GiggleFace works with macOS apps that accept virtual camera input, including Google Meet, Microsoft Teams, and FaceTime. Availability can depend on the app version, macOS permissions, and the service configuration.",
    },
    {
        question: "Does recording always run at 60 fps?",
        answer: "GiggleFace can record at up to 60 fps with audio on supported devices. Actual frame rate can vary with hardware, thermal conditions, system load, selected settings, and available storage.",
    },
    {
        question: "Does GiggleFace upload my camera or masks?",
        answer: "No. Camera frames, photos, audio, video, masks, and facial landmarks are not uploaded to developer media servers. GiggleFace sends limited anonymous usage and error diagnostics to Himetrica without media content or personal identity fields.",
    },
];

const primaryKeyword = "real-time face masks";
const secondaryKeywords = [
    "offline face mask app",
    "mac virtual camera",
    "custom camera masks",
    "video call effects",
    "60 fps camera recording",
    "Google Meet virtual camera",
    "Teams virtual camera",
    "FaceTime camera effects",
];
---

<AppTemplate
    appName={appName}
    title={title}
    pageTitle={pageTitle}
    metas={[]}
    favicon={favicon}
    appIcon={appIcon}
    socialImage={socialImage}
    socialImageAlt={socialImageAlt}
    description={description}
    screenshots={screenshots}
    faq={faq}
    facts={facts}
    features={features}
    useCases={useCases}
    testFlightUrl={testFlightUrl}
    termsOfUseUrl="/apps/giggleface/terms-of-use"
    privacyPolicyUrl="/apps/giggleface/privacy-policy"
    primaryKeyword={primaryKeyword}
    secondaryKeywords={secondaryKeywords}
    operatingSystem="iOS 26+, macOS 26+"
    lang="en"
    applicationCategory="MultimediaApplication"
/>
