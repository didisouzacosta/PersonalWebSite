---
import AppTemplate from "../../../components/app/AppTemplate.astro";

const appName = "GiggleFace";
const title = "GiggleFace - Real-Time Face Effects";
const pageTitle = "GiggleFace | Real-Time Face Effects for iPhone and Mac";
const description =
    "Bring any image to life as a custom face effect. Use it live, record video at up to 60 fps with audio, and add more fun to calls on Mac — with on-device processing.";
const favicon = "/apps/giggleface/favicon.png";
const appIcon = "giggleface/app-icon.png";
const socialImage = "/social/apps/giggleface-share-en.jpg";
const socialImageAlt = "GiggleFace showing a real-time face effect with glowing facial tracking lines.";
const testFlightUrl = "https://testflight.apple.com/join/GjXwReZf";

const screenshots = [
    {
        url: {
            en: "giggleface/screenshots/en/frame-1.png",
            ptBr: "giggleface/screenshots/ptBR/frame-1.png",
        },
        alt: "GiggleFace camera previews showing six custom face masks created from different images.",
        caption: "Turn any image into a custom mask that follows your expressions live.",
    },
    {
        url: {
            en: "giggleface/screenshots/en/frame-2.png",
            ptBr: "giggleface/screenshots/ptBR/frame-2.png",
        },
        alt: "GiggleFace recording a video with a custom clown face mask.",
        caption: "Record smooth, natural expressions with audio at up to 60 fps.",
    },
    {
        url: {
            en: "giggleface/screenshots/en/frame-3.png",
            ptBr: "giggleface/screenshots/ptBR/frame-3.png",
        },
        alt: "GiggleFace Camera on Mac pairing with an iPhone and receiving a live masked video feed.",
        caption: "Connect to GiggleFace on Mac and bring your masks to compatible video calls.",
    },
    {
        url: {
            en: "giggleface/screenshots/en/frame-4.png",
            ptBr: "giggleface/screenshots/ptBR/frame-4.png",
        },
        alt: "An image being imported into GiggleFace through the iPhone Share Sheet.",
        caption: "Import an image from your photo library or another app to create a mask.",
    },
    {
        url: {
            en: "giggleface/screenshots/en/frame-5.png",
            ptBr: "giggleface/screenshots/ptBR/frame-5.png",
        },
        alt: "GiggleFace recording offline with a custom hockey mask effect.",
        caption: "Create and record offline while your images stay on your device.",
    },
];

const facts = [
    { label: "Platforms", value: "iPhone + Mac" },
    { label: "Compatibility", value: "iOS 26+ · macOS 26+" },
    { label: "Privacy", value: "On-device processing" },
    { label: "Premium", value: "One-time purchase" },
];

const features = [
    {
        title: "Create your own face effect",
        description: "With GiggleFace Premium, turn an image from your photo library — or shared from another app — into a one-of-a-kind mask. One purchase, no subscription.",
    },
    {
        title: "Watch it come alive",
        description: "Use masks that follow your face in real time while image and facial landmark processing stays on your device.",
    },
    {
        title: "Fine-tune it your way",
        description: "Move, resize, and fit each mask in a simple editor built for quick, effortless experimentation.",
    },
    {
        title: "Share what you create",
        description: "Export your masks and send them through the system Share Sheet using the app you prefer, without relying on a GiggleFace server.",
    },
    {
        title: "Record smoothly with sound",
        description: "Capture playful face-effect videos with audio at up to 60 fps on supported devices and configurations.",
    },
    {
        title: "Bring GiggleFace to your calls",
        description: "Use GiggleFace as a virtual camera in Google Meet, Microsoft Teams, FaceTime, and other compatible apps on Mac.",
    },
];

const useCases = [
    {
        title: "Become any character you imagine",
        description: "Choose an image, create your mask, fine-tune the look, and watch the effect follow your expressions live.",
    },
    {
        title: "Create videos that make people laugh",
        description: "Record spontaneous moments with a face effect, audio, and smooth motion directly on your device.",
    },
    {
        title: "Surprise everyone on your next call",
        description: "Bring characters and custom effects to calls with friends, family, or coworkers through the virtual camera on Mac.",
    },
];

const faq = [
    {
        question: "What is GiggleFace?",
        answer: "GiggleFace is a creative camera app for iPhone and Mac that turns images into custom face effects. Use masks live, record videos with audio, and bring the result to video call apps on macOS.",
    },
    {
        question: "Does GiggleFace work offline?",
        answer: "Yes. Camera, face effect, facial tracking, and recording processing run on your device. Internet access can still be required for TestFlight, purchases and restoration, content imported from online services, anonymous diagnostics, sharing through online apps, and video calls.",
    },
    {
        question: "How do I create a custom face effect?",
        answer: "With <strong>GiggleFace Premium</strong>, choose an image from your photo library or share one from another app. Then adjust its position, scale, and fit until the mask looks just right.",
    },
    {
        question: "Can I share masks with friends?",
        answer: "Yes. Export the mask file and choose a compatible app from the system Share Sheet. GiggleFace does not host the file on its own sharing server.",
    },
    {
        question: "Is GiggleFace Premium a subscription?",
        answer: "No. The app is free to download, and Premium unlocks with one purchase and no recurring charges.",
    },
    {
        question: "Which Mac apps support GiggleFace?",
        answer: "GiggleFace works with macOS apps that support virtual cameras, including Google Meet, Microsoft Teams, and FaceTime. Availability depends on the app version, permissions, and service configuration.",
    },
    {
        question: "Does recording always run at 60 fps?",
        answer: "GiggleFace records at up to 60 fps with audio on supported devices. Actual frame rate varies with hardware, thermal conditions, system load, settings, and available storage.",
    },
    {
        question: "Does GiggleFace upload my camera or masks?",
        answer: "No. Camera frames, photos, audio, videos, masks, and facial landmarks are not uploaded to developer media servers. Himetrica receives only limited anonymous diagnostics, with no media content or personal identity fields.",
    },
];

const primaryKeyword = "real-time face effects";
const secondaryKeywords = [
    "custom face masks",
    "live camera effects",
    "face effects camera app",
    "Mac virtual camera",
    "video call effects",
    "60 fps video recording",
    "offline face mask app",
    "custom mask creator",
];
---

<AppTemplate
    appName={appName}
    title={title}
    pageTitle={pageTitle}
    metas={[]}
    favicon={favicon}
    appIcon={appIcon}
    socialImage={socialImage}
    socialImageAlt={socialImageAlt}
    description={description}
    screenshots={screenshots}
    faq={faq}
    facts={facts}
    features={features}
    useCases={useCases}
    testFlightUrl={testFlightUrl}
    termsOfUseUrl="/apps/giggleface/terms-of-use"
    privacyPolicyUrl="/apps/giggleface/privacy-policy"
    primaryKeyword={primaryKeyword}
    secondaryKeywords={secondaryKeywords}
    operatingSystem="iOS 26+, macOS 26+"
    lang="en"
    applicationCategory="MultimediaApplication"
/>
