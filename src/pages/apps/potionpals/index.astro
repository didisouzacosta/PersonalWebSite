---
import AppTemplate from "../../../components/app/AppTemplate.astro";

const title = "PotionPals: Water Sort";
const appName = "PotionPals";
const pageTitle = "PotionPals | Water Sort Color Puzzle for iPhone";
const description =
    "The classic color sorting puzzle comes to life in a cozy potion shop. Pour, sort the colors and deliver every potion to adorable jelly customers.";
const favicon = "apps/potionpals/favicon.png";
const appIcon = "potionpals/app-icon.png";
const socialImage = "potionpals/potionpals-share-en.jpg";
const socialImageAlt = "PotionPals app icon with water sort puzzle app summary.";

const metas: { name: string; content: string }[] = [];
const primaryKeyword = "water sort";
const secondaryKeywords = [
    "color sort",
    "puzzle",
    "potion",
    "liquid",
    "bottle",
    "pour",
    "logic",
    "relaxing",
    "brain teaser",
    "jelly",
    "magic",
    "cute",
];

const screenshots = [
    {
        url: {
            en: "potionpals/screenshots/en/frame-1.jpg",
            ptBr: "potionpals/screenshots/ptBR/frame-1.jpg",
        },
        alt: "PotionPals 3D home with the logo, the potion shop and the jelly customers in front of the iPhone.",
        caption: "Cute customers waiting for potions: 13 adorable jelly pals.",
    },
    {
        url: {
            en: "potionpals/screenshots/en/frame-2.jpg",
            ptBr: "potionpals/screenshots/ptBR/frame-2.jpg",
        },
        alt: "PotionPals level with jelly customers at the counter, bottles being sorted by color and Master Pingo.",
        caption: "Pour, match and get hooked! Sort the colors and fill every potion.",
    },
    {
        url: {
            en: "potionpals/screenshots/en/frame-3.jpg",
            ptBr: "potionpals/screenshots/ptBR/frame-3.jpg",
        },
        alt: "Very hard PotionPals level with bottles of different sizes and the 300 levels badge.",
        caption: "Easy to start, impossible to stop, with 300 levels that keep getting harder.",
    },
    {
        url: {
            en: "potionpals/screenshots/en/frame-4.jpg",
            ptBr: "potionpals/screenshots/ptBR/frame-4.jpg",
        },
        alt: "PotionPals Story mode map with floating islands, gates, stars and the 13 chapters badge.",
        caption: "Story Mode: a magical world of floating islands, gates and stars.",
    },
    {
        url: {
            en: "potionpals/screenshots/en/frame-5.jpg",
            ptBr: "potionpals/screenshots/ptBR/frame-5.jpg",
        },
        alt: "Hard PotionPals Challenger puzzle with a curtain, a mystery color and the 100 challenges badge.",
        caption: "Challenger Mode: can you handle it? 100 challenges, only 3 Undos.",
    },
    {
        url: {
            en: "potionpals/screenshots/en/frame-6.jpg",
            ptBr: "potionpals/screenshots/ptBR/frame-6.jpg",
        },
        alt: "PotionPals Casual mode level cleared card with 22 moves left.",
        caption: "Casual Mode: how far can you go? Earn moves with every potion.",
    },
    {
        url: {
            en: "potionpals/screenshots/en/frame-7.jpg",
            ptBr: "potionpals/screenshots/ptBR/frame-7.jpg",
        },
        alt: "PotionPals Endurance mode game with the score, the combo multiplier and the move clock.",
        caption: "Endurance Mode: how long can you last? Combos up to ×5 against the clock.",
    },
    {
        url: {
            en: "potionpals/screenshots/en/frame-8.jpg",
            ptBr: "potionpals/screenshots/ptBR/frame-8.jpg",
        },
        alt: "Night PotionPals level with curtains and locks hiding the bottles and the new mechanics badge.",
        caption: "A new surprise in every chapter: curtains, locks and mysteries.",
    },
];

const facts = [
    { label: "Platform", value: "iPhone · iOS 26+" },
    { label: "Levels", value: "300 in 13 chapters" },
    { label: "Game modes", value: "Story, Casual, Endurance, Challenger" },
    { label: "Languages", value: "English, Portuguese, Spanish, French and Japanese" },
];

const features = [
    {
        title: "Four Game Modes",
        description: "Travel through 300 Story levels on a 3D map, go as far as you can in Casual, beat your high score in Endurance or take on 100 endgame puzzles in Challenger.",
    },
    {
        title: "Rescue Master Pingo’s Friends",
        description: "A potion brewed in a hurry scattered Master Pingo’s 12 friends across the map. Find each one before a gate, in a story told in comics, and see who has already made it home.",
    },
    {
        title: "A New Surprise Every Chapter",
        description: "Collector bottles, curtains, locks, mystery colors and bottles of different sizes keep every chapter fresh, with up to 12 colors to sort.",
    },
    {
        title: "Made With Care",
        description: "Smooth pours with haptics and sounds, automatic iCloud backup, Game Center leaderboards and achievements, plus color-blind mode, Reduce Motion, Increase Contrast and Dynamic Type.",
    },
];

const useCases = [
    {
        title: "Short, relaxing breaks",
        description: "A satisfying one-handed puzzle you can play in a few minutes, with a drop of strategy and zero rush.",
    },
    {
        title: "Color sorting fans",
        description: "The classic water sort puzzle you love, set in a colorful world with a living potion shop, a 3D world map and challenges for those who want more.",
    },
];

const faq = [
    {
        question: "What is PotionPals?",
        answer: "PotionPals: Water Sort is a casual color and liquid sorting puzzle for iPhone. In a potion shop made of jelly, adorable customers line up at the counter waiting for their elixir, and it’s up to you to sort the mixed-up bottles.",
    },
    {
        question: "How do I play?",
        answer: "Tap a bottle, then another one to pour the liquid on top. You can only pour onto the same color, and only if there’s room. When a bottle holds a single color, it gets corked and flies to the customer who ordered it. Stuck? Use a <strong>Hint</strong>, <strong>Undo</strong> a move or add an <strong>extra bottle</strong>.",
    },
    {
        question: "What game modes are available?",
        answer: "<strong>Story</strong>: 300 levels across 13 chapters on a 3D map of floating islands, with gates opened by stars and Master Pingo’s friends to rescue. <strong>Casual</strong>: play level after level with one pool of moves, earning moves back with every finished potion. <strong>Endurance</strong>: a board that never ends, with combos up to ×5 and a clock on every move. <strong>Challenger</strong>: 100 endgame puzzles, from easy to very hard, with no Hint and no extra bottle, just 3 Undos.",
    },
    {
        question: "What are energy, coins and boosters?",
        answer: "Each level, run or challenge uses one energy, which refills over time. You earn stars and coins as you play, plus a daily reward and win streaks. Coins and boosters such as Hint, Undo and extra bottles can also be bought as optional in-app purchases, along with <strong>Infinite Energy</strong>.",
    },
    {
        question: "How do I restore my purchases?",
        answer: "<strong>Infinite Energy</strong> is a one-time purchase linked to your Apple Account. If you reinstall the app or switch devices, tap <em>Restore purchases</em> in the shop or the game settings and it will be verified through your Apple Account at no extra cost. Coins and booster packs are consumable and are used up as you play.",
    },
    {
        question: "Will I lose my progress if I switch iPhones?",
        answer: "Not if iCloud is on. The game saves itself to your iCloud, including levels, stars, challenges, high scores, coins and boosters. On the new device, open the game settings and tap <em>Restore iCloud backup</em>.",
    },
    {
        question: "Do I need Game Center?",
        answer: "No. Game Center leaderboards and achievements are optional. Without signing in, you can keep playing normally and your progress is saved on your iPhone and in your iCloud.",
    },
    {
        question: "How do I join the beta?",
        answer: "PotionPals is open for testing on TestFlight. Install the TestFlight app on your iPhone, tap <strong>Join TestFlight</strong> on this page and accept the invitation. You can send feedback and report problems right from TestFlight.",
    },
    {
        question: "Is PotionPals accessible?",
        answer: "Yes. PotionPals supports a color-blind mode, Reduce Motion, Increase Contrast and Dynamic Type.",
    },
];
---

<AppTemplate
    testFlightUrl="https://testflight.apple.com/join/Z3zPD8qJ"
    title={title}
    appName={appName}
    pageTitle={pageTitle}
    metas={metas}
    favicon={favicon}
    appIcon={appIcon}
    socialImage={socialImage}
    socialImageAlt={socialImageAlt}
    description={description}
    screenshots={screenshots}
    faq={faq}
    facts={facts}
    features={features}
    useCases={useCases}
    primaryKeyword={primaryKeyword}
    secondaryKeywords={secondaryKeywords}
    lang="en"
    applicationCategory="GameApplication"
/>
