---
import AppTemplate from "../../../components/app/AppTemplate.astro";

const title = "Pillo: Medicine Expiry Dates";
const appName = "Pillo";
const pageTitle = "Pillo | Medicine expiry dates and reminders for iPhone";
const description =
    "Track your medicines' expiry dates, with a reminder before they expire and an alarm when it is time to take them, all offline. Medicine data comes from the official ANVISA database, and AI summarizes the leaflet in plain words, always with the sources.";
const favicon = "apps/pillo/favicon.png";
const appIcon = "pillo/app-icon.png";
const socialImage = "pillo/pillo-share-en.jpg";
const socialImageAlt = "Pillo app icon with the words an alarm at dose time, a heads-up before it expires and official ANVISA data, next to the medicine list and the alarm.";

const metas: { name: string; content: string }[] = [];
const primaryKeyword = "medicine expiry date";
const secondaryKeywords = [
    "medication reminder",
    "medication alarm",
    "pill reminder",
    "expired medicine",
    "medicine cabinet",
    "expiry tracker",
    "drug leaflet",
    "ANVISA data",
    "generic medicine",
    "medicine disposal",
    "maximum medicine price",
    "Brazil",
    "app for seniors",
];

const screenshots = [
    {
        url: "pillo/screenshots/ptBR/frame-1.jpg",
        alt: "Pillo alarm on the Lock Screen when it is time to take the dipyrone, with Stop and Taken buttons (app in Portuguese).",
        caption: "Time to take it, with an alarm: it rings even on silent and you mark it as taken right on the alarm.",
    },
    {
        url: "pillo/screenshots/ptBR/frame-2.jpg",
        alt: "Dipyrone detail with the Pain and fever and No prescription needed tags, the reference medicine Novalgina, what it is for, the AI leaflet summary and the link to the full leaflet in the ANVISA Bulário (app in Portuguese).",
        caption: "Official ANVISA data: what it is for, prescription, reference medicine and the full leaflet.",
    },
    {
        url: "pillo/screenshots/ptBR/frame-3.jpg",
        alt: "Pillo list with the dose due highlighted with a Taken button, the dose reminders and the expired medicines first (app in Portuguese).",
        caption: "Medicines always in date: the dose due highlighted and what has expired first.",
    },
    {
        url: "pillo/screenshots/ptBR/frame-4.jpg",
        alt: "iPhone Home Screen with the large dose reminders widget, with a Taken button, and the medium upcoming expiries widget (app in Portuguese).",
        caption: "Widgets on the Home Screen: mark a dose as taken without opening the app.",
    },
    {
        url: "pillo/screenshots/ptBR/frame-5.jpg",
        alt: "Dipyrone detail with the leaflet dosage, the dose reminder and the last 7 days of doses on time, late or missed (app in Portuguese).",
        caption: "How you have been taking it: the doses of the last 7 days.",
    },
    {
        url: "pillo/screenshots/ptBR/frame-6.jpg",
        alt: "Pillo notification on the Lock Screen saying the dipyrone expires in 7 days (app in Portuguese).",
        caption: "A reminder before it expires: 30 and 7 days before and on the day.",
    },
    {
        url: "pillo/screenshots/ptBR/frame-7.jpg",
        alt: "Pillo camera reading the barcode of a dipyrone box, in step 1 of 2 (app in Portuguese).",
        caption: "Point the camera at the box: the code brings the ANVISA data, and the expiry date comes in 2 steps.",
    },
    {
        url: "pillo/screenshots/ptBR/frame-8.jpg",
        alt: "Dipyrone detail with the average price, the maximum allowed price, the details with the registration number and the reference sources, starting with gov.br/anvisa (app in Portuguese).",
        caption: "The official maximum price and the sources, with links to check them.",
    },
    {
        url: "pillo/screenshots/ptBR/frame-9.jpg",
        alt: "Expired amoxicillin in Pillo, with the Bacterial infection and The pharmacy keeps the prescription tags, the disposal guidance and the link to find a drop-off point (app in Portuguese).",
        caption: "Expired? Pillo shows how to dispose of it the right way.",
    },
    {
        url: "pillo/screenshots/ptBR/frame-10.jpg",
        alt: "Pillo cards: no account and no ads, everything on your iPhone, works offline, reminders your way, large text and ANVISA data with an AI summary (app in Portuguese).",
        caption: "Simple and private: no account, no ads, everything on your iPhone.",
    },
];

const facts = [
    { label: "Platform", value: "iPhone · iOS 26+" },
    { label: "Account", value: "Not needed" },
    { label: "Doses", value: "Alarm at dose time" },
    { label: "Reminders", value: "30 and 7 days before" },
    { label: "Offline", value: "Expiry and alarms" },
    { label: "Information", value: "ANVISA data and AI summary" },
    { label: "Language", value: "Portuguese (Brazil)" },
    { label: "App Store", value: "Coming soon" },
];

const features = [
    {
        title: "Expiry tracking",
        description: "Expired medicines come first, then the ones expiring soon and the ones still in date. Each one shows the box image and how many days are left, and you can search any medicine by name.",
    },
    {
        title: "A reminder before it expires",
        description: "Get reminders 30 days before, 7 days before and on the expiry day, at the time you choose. If a medicine expires, Pillo reminds you once a week until you dispose of it.",
    },
    {
        title: "Time to take it, with an alarm",
        description: "Turn on a dose reminder with the interval, first dose and length of your prescription. An alarm rings on time, even in silent mode, and you mark it as taken right on the alarm or on the highlight in the list. Each reminder shows the time, the medicine and the interval, like every 8 hours, and a tap opens the reminder so you can change what you need. Pillo shows how you have been taking it over the last 7 days and stops the reminders when the medicine expires.",
    },
    {
        title: "Official ANVISA data",
        description: "Medicine data comes from the official database of ANVISA, Brazil's health regulatory agency: the name, presentation, active ingredient, manufacturer and registration number. Pillo shows in plain words what it is for, whether it is sold without a prescription, needs one or the pharmacy keeps the prescription, the reference medicine of generics and similars, like Equivalente ao Novalgina, and the maximum price a pharmacy may charge, from the official list published by ANVISA. If the registration is no longer valid, Pillo tells you, and Ver bula completa opens the ANVISA leaflet library (Bulário). Pillo is not affiliated with ANVISA.",
    },
    {
        title: "AI leaflet summary",
        description: "After you save, Pillo uses artificial intelligence to read the patient leaflet on the manufacturer's website and summarize it in plain words: how it works, how to take it, the general adult dosage and how to store it. Without the manufacturer's leaflet, it summarizes the main public references and leaves the dosage out. Every source used, from ANVISA and the leaflet, is listed in the medicine's details, with a link so you can check it, along with the average price in online pharmacies. The summary may be wrong and does not replace your doctor or pharmacist.",
    },
    {
        title: "Share and copy",
        description: "Share a medicine with its box image and summary through Messages, email or any app you like. Under Informações, copy everything with one tap, or just the batch, registration number or barcode.",
    },
    {
        title: "Widgets on the Home Screen",
        description: "Add Pillo to your Home Screen in medium or large size. Choose between the dose reminders, with the dose due and a Taken button to mark it without opening the app, and the upcoming expiries, with the medicines that expire first.",
    },
    {
        title: "Read the box in 2 steps",
        description: "Point the camera at the barcode and then at the expiry date, batch and manufacturing date; the name comes from the code. Pillo shows what it read at each step, you can clear it and read again, then check the summary and save with one tap. Or type the details in if you prefer.",
    },
    {
        title: "Works offline",
        description: "Only looking up the medicine information uses the internet and artificial intelligence. Expiry tracking, reminders, alarms, dose reminders, the doses you mark and reading the box work fully offline.",
    },
    {
        title: "Dispose of it the right way",
        description: "Expired medicine does not belong in the trash or down the sink. Pillo explains what to do and opens Maps so you can find a drop-off point.",
    },
    {
        title: "Simple and private",
        description: "No account and no ads. Pillo never takes or keeps photos: your medicines, dates, reminders and the doses you mark stay on your iPhone and only leave it when you share or copy them. The app follows the text size you use on your device.",
    },
];

const useCases = [
    {
        title: "The home medicine cabinet",
        description: "That medicine kept for when you need it no longer catches anyone by surprise: you know what is still good and what needs replacing.",
    },
    {
        title: "Caring for parents and grandparents",
        description: "Keep the family's medicines in a clear list, with large text, an alarm at each dose and a reminder before each one expires.",
    },
];

const faq = [
    {
        question: "What is Pillo?",
        answer: "Pillo is an iPhone app that keeps track of the expiry dates of the medicines in your home and reminds you when to take them. You point the camera at the box, check the details and Pillo reminds you before each medicine expires; if you want, you turn on a dose reminder with an alarm at the times of your prescription. The app is in Portuguese and made for Brazil.",
    },
    {
        question: "How does Pillo read the box?",
        answer: "In 2 steps, with the camera recognizing text and barcodes on the iPhone itself: first the barcode (or the 2D code or the registration number) and then the expiry date, batch and manufacturing date. The name comes from the code, through the ANVISA database, after you save. Each step shows what was read, and you tap Continue when it is right. Pillo does not take photos. If reading does not work, you can type the details in.",
    },
    {
        question: "How do dose reminders work?",
        answer: "On the medicine, under Administração, tap Lembrar de tomar and set the interval (every 4 to every 24 hours), the first dose and the length: ongoing or a number of days. At dose time, an iPhone alarm rings even in silent mode, with Stop and Taken buttons. The dose due also shows highlighted in the list, with a Taken button, and Pillo shows how many doses you took on time, late or missed over the last 7 days. Tap a reminder in the list to open the medicine's reminder and change the time, interval or length. If you do not allow alarms, Pillo sends a notification instead. Reminders stop at the end of the treatment or when the medicine expires.",
    },
    {
        question: "Does Pillo have widgets?",
        answer: "Yes, in medium and large sizes. Touch and hold the Home Screen, tap Edit and Add Widget, and choose Pillo. In Edit Widget, choose what to show: the dose reminders, with a Taken button, or the upcoming expiries. Tapping a reminder opens the medicine's reminder in the app; tapping an expiry opens the medicine's details.",
    },
    {
        question: "Does Pillo tell me which dose to take?",
        answer: "No. Pillo shows the leaflet's general adult dosage, summarized by AI, only as a reference, and never calculates a dose. When the leaflet has a dose for children, it only notes that it depends on age or weight. The reminder uses the interval and length you copy from your prescription, and what your doctor or pharmacist told you always comes first.",
    },
    {
        question: "When do I get reminders?",
        answer: "By default, 30 days before, 7 days before and on the expiry day, at the time you choose in Settings. Expired medicines can get a weekly reminder until you dispose of them. Reminders arrive as notifications, even with the app closed.",
    },
    {
        question: "Does Pillo work offline?",
        answer: "Yes. Only looking up the medicine information uses the internet and artificial intelligence. Expiry tracking, reminders, alarms, dose reminders, the doses you mark and reading the box work fully offline. The lookup happens after you save: the medicine shows under Analyzing, right below the counters, and moves to its place when the lookup ends. Offline, it stays saved with a Try again option, and Pillo tries again when you come back to the app.",
    },
    {
        question: "Where does the medicine information come from?",
        answer: "Medicine data comes from the official database of ANVISA, Brazil's health regulatory agency, through its open data and the CMED price list: the name, presentation, active ingredient, manufacturer, registration number, what it is for, whether it needs a prescription, the reference medicine and the maximum price. Artificial intelligence only summarizes the patient leaflet, read on the manufacturer's website, or, without it, the main public references, in plain words. Every source appears in the medicine's details, under Fontes de referência (Reference sources), with a link so you can check it, and Ver bula completa opens the ANVISA leaflet library. The summary may contain mistakes, does not recommend treatments, never calculates a dose and does not replace advice from a doctor or pharmacist. Supplements and other products that are not in the ANVISA medicine database, like creatine, show only the AI summary of public sources. The box image is illustrative, generated by AI. Pillo is not affiliated with ANVISA or any other government agency.",
    },
    {
        question: "Can I share or copy the information?",
        answer: "Yes. In the medicine's details, the share button sends the box image and the summary (name, expiry date, what it is for, how it works, how to take it and the details) to the app or person you choose; reminders and doses are not included. Under Informações, Copiar copies everything at once, and a long press on a row copies just that value.",
    },
    {
        question: "What are the average and maximum prices?",
        answer: "The maximum allowed price is the most a pharmacy may charge for that presentation, from the official CMED list published by ANVISA, with 18% ICMS tax. The average price is the average of the same presentation in Brazilian online pharmacies, with how many pharmacies and the date it was checked, checked again when it is more than 30 days old. Both are only a reference: prices vary by pharmacy and region, and Pillo does not sell medicines.",
    },
    {
        question: "Where is my data kept?",
        answer: "On your iPhone, including your dose reminders and the doses you mark, and it only leaves it when you share or copy it. Pillo has no account, never takes or keeps photos, shows no ads and does not collect usage analytics. To look up information, it sends only the barcode, registration number or name of the medicine, with nothing that identifies you. See the <a href=\"/apps/pillo/privacy-policy/\">Privacy Policy</a> for details.",
    },
    {
        question: "What should I do with an expired medicine?",
        answer: "Do not throw it in the trash, the sink or the toilet. Take the box to a pharmacy or health center with a drop-off point. In Pillo, tap <em>Encontrar ponto de coleta</em> to open the search in Maps.",
    },
    {
        question: "How much does it cost and when is it coming?",
        answer: "Pillo is free and has no ads. It is coming soon to the App Store in Brazil, for iPhone with iOS 26 or later.",
    },
];
---

<AppTemplate
    title={title}
    appName={appName}
    pageTitle={pageTitle}
    metas={metas}
    favicon={favicon}
    appIcon={appIcon}
    socialImage={socialImage}
    socialImageAlt={socialImageAlt}
    description={description}
    screenshots={screenshots}
    faq={faq}
    facts={facts}
    features={features}
    useCases={useCases}
    primaryKeyword={primaryKeyword}
    secondaryKeywords={secondaryKeywords}
    lang="en"
    applicationCategory="HealthApplication"
/>
