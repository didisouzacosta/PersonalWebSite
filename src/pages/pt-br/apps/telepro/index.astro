const useCases = [
    {
        title: "Criadores e vídeos para as redes",
        description: "Grave Reels, TikToks e Shorts olhando para a lente, corte o tempo morto e publique com legendas que dá para ler sem som.",
    },
    {
        title: "Professores, mentores e empreendedores",
        description: "Tutoriais, aulas, demonstrações de produto, pitches e apresentações gravados de primeira, com o roteiro sempre à vista.",
    },
];

const faq = [
    {
        question: "O que é o TelePro?",
        answer: "O TelePro é um teleprompter com câmera para iPhone. O roteiro rola bem ao lado da lente enquanto você grava e, depois, você corta os silêncios e adiciona legendas automáticas sem sair do app.",
    },
    {
        question: "O TelePro funciona offline?",
        answer: "Sim. Gravação, teleprompter, remoção de silêncios e legendas automáticas funcionam no seu iPhone, sem internet e sem conta. As exceções são o primeiro download do modelo de fala de um idioma pelo iOS, as compras pela App Store e o compartilhamento dos vídeos.",
    },
    {
        question: "Como funciona o teleprompter?",
        answer: "Escreva ou cole o roteiro, escolha a velocidade, o tamanho da fonte e as linhas visíveis e grave. O texto rola ao lado da câmera frontal, com contagem opcional e parada automática quando o roteiro termina.",
    },
    {
        question: "Como funciona o Remover silêncios?",
        answer: "O TelePro analisa o áudio da gravação no aparelho, marca as pausas na linha do tempo e deixa você ajustar a duração da pausa, a folga e a sensibilidade. Dá para ver com e sem os cortes, e o original fica guardado para você desfazer quando quiser.",
    },
    {
        question: "As legendas são enviadas para algum lugar?",
        answer: "Não. As legendas automáticas usam o reconhecimento de fala da Apple no aparelho, então o áudio é transcrito no seu iPhone. Você corrige qualquer palavra, muda estilo, cor, tamanho e posição e compartilha o vídeo com a legenda gravada na imagem.",
    },
    {
        question: "O que é grátis e o que vem no Pro?",
        answer: "A versão grátis grava vídeos de até 15 segundos, mostra a prévia da remoção de silêncios e legenda no estilo clássico. O <strong>TelePro Pro</strong> libera gravação sem limite de tempo, o teleprompter durante a gravação, salvar seus roteiros, aplicar os cortes de silêncio e todos os estilos de legenda.",
    },
    {
        question: "Quanto custa o TelePro Pro?",
        answer: "O TelePro Pro é uma assinatura anual com renovação automática e 3 dias grátis para novos assinantes elegíveis. O preço na sua moeda aparece no app antes de você confirmar. Você pode cancelar quando quiser nos ajustes da sua Conta Apple, pelo menos 24 horas antes da renovação.",
    },
    {
        question: "Como restauro minha compra?",
        answer: "No app, abra os Ajustes, toque no card da assinatura e depois em <em>Restaurar compras</em> na tela da assinatura. O TelePro confere sua Conta Apple e libera o Pro de novo sem custo extra, num iPhone novo ou depois de reinstalar o app.",
    },
];
---

<AppTemplate
    appId={appId}
    appStoreUrl={appStoreUrl}
    title={title}
    appName={appName}
    pageTitle={pageTitle}
    metas={metas}
    favicon={favicon}
    appIcon={appIcon}
    socialImage={socialImage}
    socialImageAlt={socialImageAlt}
    description={description}
    screenshots={screenshots}
    faq={faq}
    facts={facts}
    features={features}
    useCases={useCases}
    primaryKeyword={primaryKeyword}
    secondaryKeywords={secondaryKeywords}
    lang="pt-br"
    applicationCategory="MultimediaApplication"
/>
