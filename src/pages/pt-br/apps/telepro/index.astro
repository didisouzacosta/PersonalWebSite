const facts = [
    { label: "Plataforma", value: "iPhone · iOS 26+" },
    { label: "Funciona", value: "Offline" },
    { label: "Edição", value: "Silêncios + legendas" },
    { label: "Idiomas", value: "6 idiomas" },
    { label: "Pro", value: "3 dias grátis" },
];

const features = [
    {
        title: "Teleprompter na câmera",
        description: "Escreva ou cole o roteiro e leia bem ao lado da lente. Você mantém o olhar na câmera, não esquece o texto e grava de primeira.",
    },
    {
        title: "No seu ritmo",
        description: "Escolha lento, normal ou rápido, ajuste o tamanho da fonte e quantas linhas ficam visíveis. Uma contagem abre a gravação, e ela pode parar sozinha quando o roteiro termina.",
    },
    {
        title: "Remova os silêncios num toque",
        description: "O TelePro encontra as pausas da gravação e marca na linha do tempo. Escolha a duração da pausa, a folga e a sensibilidade, veja o corte antes e desfaça quando quiser.",
    },
    {
        title: "Legendas automáticas no iPhone",
        description: "A fala é transcrita no aparelho, então o áudio nunca sai do seu iPhone. Toque numa palavra para corrigir, escolha estilo e cor e compartilhe o vídeo com a legenda gravada na imagem.",
    },
    {
        title: "Totalmente offline e privado",
        description: "Gravação, teleprompter, remoção de silêncios e legendas funcionam no seu iPhone, sem conta. Seus vídeos ficam na galeria do app até você decidir compartilhar.",
