---
import AppTemplate from "../../../../components/app/AppTemplate.astro";

const title = "Pillo: Validade de Remédios";
const appName = "Pillo";
const pageTitle = "Pillo | Validade e lembrete de remédios para iPhone";
const description =
    "Controle a validade dos remédios, com aviso antes de vencer e alarme na hora de tomar, tudo offline. Com IA, o Pillo busca as principais referências sobre cada remédio e resume em palavras simples, sempre com as fontes.";
const favicon = "apps/pillo/favicon.png";
const appIcon = "pillo/app-icon.png";
const socialImage = "pillo/pillo-share-pt-br.jpg";
const socialImageAlt = "Ícone do app Pillo ao lado das telas da lista de remédios com a dose da vez e do alarme na hora de tomar.";

const metas: { name: string; content: string }[] = [];
const primaryKeyword = "validade de remédios";
const secondaryKeywords = [
    "lembrete de remédio",
    "alarme de remédio",
    "hora de tomar remédio",
    "remédio vencido",
    "vencimento de medicamentos",
    "controle de validade",
    "farmacinha de casa",
    "bula",
    "descarte de medicamentos",
    "preço de remédio",
    "app para idosos",
];

const screenshots = [
    {
        url: "pillo/screenshots/ptBR/frame-1.jpg",
        alt: "Alarme do Pillo na tela bloqueada na hora de tomar a dipirona, com os botões Parar e Tomei.",
        caption: "Hora de tomar, com alarme: toca até no silencioso e você marca Tomei no próprio alarme.",
    },
    {
        url: "pillo/screenshots/ptBR/frame-2.jpg",
        alt: "Lista do Pillo com a dose da vez em destaque e o botão Tomei, os lembretes de tomada e os remédios vencidos primeiro.",
        caption: "Remédios sempre em dia: a dose da vez em destaque e o que venceu primeiro.",
    },
    {
        url: "pillo/screenshots/ptBR/frame-3.jpg",
        alt: "Tela de início do iPhone com o widget grande dos lembretes de tomada, com o botão Tomei, e o widget médio dos próximos vencimentos.",
        caption: "Widgets na tela de início: marque Tomei sem abrir o app.",
    },
    {
        url: "pillo/screenshots/ptBR/frame-4.jpg",
        alt: "Detalhe da dipirona com a posologia da bula, o lembrete de tomada e as doses dos últimos 7 dias no horário, com atraso ou esquecidas.",
        caption: "Como você vem tomando: as doses dos últimos 7 dias.",
    },
    {
        url: "pillo/screenshots/ptBR/frame-5.jpg",
        alt: "Notificação do Pillo na tela bloqueada avisando que a dipirona vence em 7 dias.",
        caption: "Aviso antes de vencer: 30 e 7 dias antes e no dia do vencimento.",
    },
    {
        url: "pillo/screenshots/ptBR/frame-6.jpg",
        alt: "Câmera do Pillo lendo o código de barras da caixa de dipirona, no passo 1 de 2.",
        caption: "Aponte a câmera para a caixa: o Pillo lê o código e a validade em 2 passos.",
    },
    {
        url: "pillo/screenshots/ptBR/frame-7.jpg",
        alt: "Detalhe da dipirona com a validade e para que serve, em palavras simples.",
        caption: "Para que serve? Um resumo em palavras simples, com as fontes.",
    },
    {
        url: "pillo/screenshots/ptBR/frame-8.jpg",
        alt: "Remédio vencido no Pillo com a orientação de descarte e o link para encontrar um ponto de coleta.",
        caption: "Venceu? O Pillo mostra como descartar do jeito certo.",
    },
    {
        url: "pillo/screenshots/ptBR/frame-9.jpg",
        alt: "Cards do Pillo: sem conta e sem anúncios, tudo no seu iPhone, funciona sem internet, avisos do seu jeito, letras grandes e resumo por IA.",
        caption: "Simples e privado: sem conta, sem anúncios, tudo no seu iPhone.",
    },
];

const facts = [
    { label: "Plataforma", value: "iPhone · iOS 26+" },
    { label: "Conta", value: "Não precisa" },
    { label: "Lembretes", value: "Alarme na hora de tomar" },
    { label: "Avisos", value: "30 e 7 dias antes" },
    { label: "Offline", value: "Validade e alarmes" },
    { label: "Informações", value: "Resumo por IA, com fontes" },
    { label: "App Store", value: "Em breve" },
];

const features = [
    {
        title: "Controle de validade",
        description: "Os remédios vencidos aparecem primeiro, depois os que vencem em breve e os que estão em dia. Cada um mostra a imagem da caixa e quantos dias faltam, e você busca qualquer remédio pelo nome.",
    },
    {
        title: "Aviso antes de vencer",
        description: "Receba avisos 30 dias antes, 7 dias antes e no dia do vencimento, no horário que você escolher. Se o remédio vencer, o Pillo lembra uma vez por semana até você descartar.",
    },
    {
        title: "Hora de tomar, com alarme",
        description: "Ligue o lembrete com o intervalo, a primeira dose e a duração da sua receita. Um alarme toca na hora, mesmo no modo silencioso, e você marca Tomei no próprio alarme ou no destaque da lista. Cada lembrete mostra o horário, o remédio e o período, como De 8 em 8 horas, e um toque abre o lembrete para mudar o que precisar. O Pillo mostra como você vem tomando nos últimos 7 dias e para os lembretes quando o remédio vence.",
    },
    {
        title: "Informações com IA, das principais referências",
        description: "Depois de salvar, o Pillo usa inteligência artificial para buscar na internet as principais referências públicas sobre o remédio, como a bula do fabricante, e resume em palavras simples: para que serve, como funciona, como usar, a posologia geral da bula para adultos e como guardar. Todas as fontes usadas ficam listadas no detalhe do remédio, com link para você conferir, junto com o preço médio em farmácias online. O resumo pode errar e não dispensa o médico nem o farmacêutico.",
    },
    {
        title: "Compartilhe e copie",
        description: "Compartilhe um remédio com a imagem da caixa e o resumo, por mensagem, e-mail ou o app que preferir. Em Informações, copie tudo com um toque, ou só o lote, o registro ou o código de barras.",
    },
    {
        title: "Widgets na tela de início",
        description: "Coloque o Pillo na tela de início, em tamanho médio ou grande. Escolha entre os lembretes de tomada, com a dose da vez e o botão Tomei para marcar sem abrir o app, e os próximos vencimentos, com os remédios que vencem primeiro.",
    },
    {
        title: "Leia a caixa em 2 passos",
        description: "Aponte a câmera para o código de barras e depois para a validade, o lote e a fabricação; o nome vem do código. O Pillo mostra o que leu em cada passo, você apaga e lê de novo se precisar, confere o resumo e salva com um toque. Se preferir, digite à mão.",
    },
    {
        title: "Funciona sem internet",
        description: "Só a busca das informações do remédio usa a internet e a inteligência artificial. O controle de validade, os avisos, os alarmes, os lembretes de tomada, o registro das doses e a leitura da caixa funcionam totalmente offline.",
    },
    {
        title: "Descarte do jeito certo",
        description: "Remédio vencido não vai para o lixo comum nem para a pia. O Pillo explica o que fazer e abre o Mapas para você encontrar um ponto de coleta.",
    },
    {
        title: "Simples e privado",
        description: "Sem conta e sem anúncios. O Pillo não tira nem guarda fotos: os remédios, as datas, os lembretes e as doses ficam no seu iPhone e só saem dele quando você compartilha ou copia. O app acompanha o tamanho de texto que você usa no aparelho.",
    },
];

const useCases = [
    {
        title: "A farmacinha de casa",
        description: "Aquele remédio guardado para quando precisar não pega mais ninguém de surpresa: você sabe o que ainda vale e o que precisa trocar.",
    },
    {
        title: "Quem cuida de pais e avós",
        description: "Organize os remédios da família numa lista clara, com letras grandes, alarme na hora de cada dose e avisos antes de cada vencimento.",
    },
];

const faq = [
    {
        question: "O que é o Pillo?",
        answer: "O Pillo é um app para iPhone que organiza a validade dos remédios da sua casa e lembra a hora de tomar. Você aponta a câmera para a caixa, confere os dados e o Pillo avisa antes de cada remédio vencer; se quiser, liga um lembrete de tomada com alarme nos horários da sua receita.",
    },
    {
        question: "Como o Pillo lê a caixa?",
        answer: "Em 2 passos, com a câmera reconhecendo o texto e o código de barras no próprio iPhone: primeiro o código de barras (ou o código 2D ou o registro) e depois a validade, o lote e a fabricação. O nome vem do código, depois de salvar. Cada passo mostra o que foi lido, e você toca em Continuar quando estiver certo. O Pillo não tira foto. Se a leitura não der certo, dá para digitar os dados à mão.",
    },
    {
        question: "Como funciona o lembrete de tomada?",
        answer: "No remédio, em Administração, toque em Lembrar de tomar e informe o intervalo (de 4 em 4 até de 24 em 24 horas), a primeira dose e a duração: uso contínuo ou um número de dias. Na hora, um alarme do iPhone toca mesmo no modo silencioso, com os botões Parar e Tomei. A dose da vez também aparece em destaque na lista, com o botão Tomei, e o Pillo mostra quantas doses você tomou no horário, com atraso ou esqueceu nos últimos 7 dias. Toque num lembrete da lista para abrir o lembrete do remédio e mudar o horário, o intervalo ou a duração. Se você não permitir os alarmes, o Pillo avisa por notificação. Os lembretes param no fim do tratamento ou quando o remédio vence.",
    },
    {
        question: "O Pillo tem widgets?",
        answer: "Sim, em tamanho médio e grande. Toque e segure a tela de início, toque em Editar e em Adicionar widget e escolha o Pillo. Em Editar widget, escolha o que mostrar: os lembretes de tomada, com o botão Tomei, ou os próximos vencimentos. Tocar num lembrete abre o lembrete do remédio no app; tocar num vencimento abre o detalhe do remédio.",
    },
    {
        question: "O Pillo diz qual dose eu devo tomar?",
        answer: "Não. O Pillo mostra a posologia geral da bula para adultos, resumida por inteligência artificial, só como referência, e nunca calcula dose. Quando a bula tem dose para crianças, ele só avisa que depende da idade ou do peso. O lembrete usa o intervalo e a duração que você copia da sua receita, e vale sempre o que o médico ou o farmacêutico orientou.",
    },
    {
        question: "Quando recebo os avisos?",
        answer: "Por padrão, 30 dias antes, 7 dias antes e no dia do vencimento, no horário que você escolher nos Ajustes. Remédios vencidos podem receber um aviso por semana até você descartar. Os avisos chegam como notificação, mesmo com o app fechado.",
    },
    {
        question: "O Pillo funciona sem internet?",
        answer: "Sim. Só a busca das informações do remédio usa a internet e a inteligência artificial. O controle de validade, os avisos, os alarmes, os lembretes de tomada, o registro das doses e a leitura da caixa funcionam totalmente offline. A busca acontece depois de salvar: o remédio aparece em Analisando, logo abaixo dos contadores, e vai para o lugar certo quando a busca termina. Sem internet, ele fica salvo, com a opção de tentar de novo, e o Pillo tenta outra vez quando você volta ao app.",
    },
    {
        question: "De onde vêm as informações dos remédios?",
        answer: "O Pillo usa inteligência artificial só para buscar na internet as principais referências públicas sobre o remédio, como a bula do fabricante, e escrever um resumo em palavras simples. Todas as fontes usadas aparecem no detalhe do remédio, na seção Fontes, com link para você conferir. O resumo pode conter erros, não indica tratamento, não calcula dose e não dispensa a orientação de um médico ou farmacêutico. A imagem da caixa é ilustrativa, gerada por IA. O Pillo não é afiliado a órgãos do governo.",
    },
    {
        question: "Posso compartilhar ou copiar as informações?",
        answer: "Sim. No detalhe do remédio, o botão de compartilhar envia a imagem da caixa e o resumo (nome, validade, para que serve, como funciona, como usar e as informações) para o app ou a pessoa que você escolher; os lembretes e as doses não vão junto. Em Informações, Copiar copia tudo de uma vez, e um toque longo numa linha copia só aquele valor.",
    },
    {
        question: "O que é o preço médio?",
        answer: "É a média do preço da mesma apresentação do remédio em farmácias online do Brasil, com o número de farmácias e a data da consulta. Serve só como referência: o preço varia por farmácia e região, e o Pillo não vende remédios. A consulta é refeita quando o preço tem mais de 30 dias.",
    },
    {
        question: "Meus dados ficam onde?",
        answer: "No seu iPhone, inclusive os lembretes e as doses que você marca, e só saem dele quando você compartilha ou copia. O Pillo não tem conta, não tira nem guarda fotos, não exibe anúncios e não usa estatísticas de uso. Para buscar as informações, ele envia só o código de barras, o registro ou o nome do remédio, sem nada que identifique você. Veja os detalhes na <a href=\"/pt-br/apps/pillo/privacy-policy/\">Política de Privacidade</a>.",
    },
    {
        question: "O que faço com um remédio vencido?",
        answer: "Não jogue no lixo comum, na pia ou no vaso sanitário. Leve a caixa a uma farmácia ou posto de saúde com ponto de coleta. No Pillo, toque em <em>Encontrar ponto de coleta</em> para abrir a busca no Mapas.",
    },
    {
        question: "Quanto custa e quando chega na App Store?",
        answer: "O Pillo é gratuito e sem anúncios. Ele chega em breve à App Store do Brasil, para iPhone com iOS 26 ou posterior.",
    },
];
---

<AppTemplate
    title={title}
    appName={appName}
    pageTitle={pageTitle}
    metas={metas}
    favicon={favicon}
    appIcon={appIcon}
    socialImage={socialImage}
    socialImageAlt={socialImageAlt}
    description={description}
    screenshots={screenshots}
    faq={faq}
    facts={facts}
    features={features}
    useCases={useCases}
    primaryKeyword={primaryKeyword}
    secondaryKeywords={secondaryKeywords}
    lang="pt-br"
    applicationCategory="HealthApplication"
/>
