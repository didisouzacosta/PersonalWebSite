---
import AppTemplate from "../../../../components/app/AppTemplate.astro";

const title = "Pillo: Validade de Remédios";
const appName = "Pillo";
const pageTitle = "Pillo | Validade e lembrete de remédios para iPhone";
const description =
    "Fotografe a caixa e o Pillo guarda a validade dos seus remédios e avisa antes de vencer. Lista simples, letras grandes e resumo da bula oficial da ANVISA.";
const favicon = "apps/pillo/favicon.png";
const appIcon = "pillo/app-icon.png";
const socialImage = "pillo/pillo-share-pt-br.jpg";
const socialImageAlt = "Ícone do app Pillo ao lado das telas da lista de remédios e do aviso de vencimento.";

const metas: { name: string; content: string }[] = [];
const primaryKeyword = "validade de remédios";
const secondaryKeywords = [
    "lembrete de remédio",
    "remédio vencido",
    "vencimento de medicamentos",
    "controle de validade",
    "farmacinha de casa",
    "bula",
    "descarte de medicamentos",
    "ANVISA",
    "app para idosos",
];

const screenshots = [
    {
        url: "pillo/screenshots/ptBR/frame-1.jpg",
        alt: "Lista do Pillo com os remédios vencidos primeiro, depois os que vencem em breve e os que estão em dia, cada um com os dias que faltam.",
        caption: "Remédios sempre em dia: o que venceu aparece primeiro.",
    },
    {
        url: "pillo/screenshots/ptBR/frame-2.jpg",
        alt: "Notificação do Pillo na tela bloqueada avisando que a dipirona vence em 7 dias.",
        caption: "Aviso antes de vencer: 30 e 7 dias antes e no dia do vencimento.",
    },
    {
        url: "pillo/screenshots/ptBR/frame-3.jpg",
        alt: "Câmera do Pillo lendo a caixa de um remédio, com o nome, o código de barras e o registro marcados.",
        caption: "Fotografe a caixa e o Pillo lê o nome, o código e a validade.",
    },
    {
        url: "pillo/screenshots/ptBR/frame-4.jpg",
        alt: "Detalhe da dipirona com a validade, para que serve e como funciona, em palavras simples.",
        caption: "Para que serve? Resumo da bula oficial, em palavras simples.",
    },
    {
        url: "pillo/screenshots/ptBR/frame-5.jpg",
        alt: "Tela Confira os dados com o remédio encontrado na ANVISA, a validade lida da caixa e o lembrete.",
        caption: "Confira os dados e salve com um toque.",
    },
    {
        url: "pillo/screenshots/ptBR/frame-6.jpg",
        alt: "Remédio vencido no Pillo com a orientação de descarte e o botão para encontrar um ponto de coleta.",
        caption: "Venceu? O Pillo mostra como descartar do jeito certo.",
    },
    {
        url: "pillo/screenshots/ptBR/frame-7.jpg",
        alt: "Cards do Pillo: sem conta e sem anúncios, tudo no seu iPhone, funciona sem internet, avisos do seu jeito, letras grandes e informações da ANVISA.",
        caption: "Simples e privado: sem conta, sem anúncios, tudo no seu iPhone.",
    },
];

const facts = [
    { label: "Plataforma", value: "iPhone · iOS 26+" },
    { label: "Conta", value: "Não precisa" },
    { label: "Avisos", value: "30 e 7 dias antes" },
    { label: "Informações", value: "ANVISA" },
    { label: "App Store", value: "Em breve" },
];

const features = [
    {
        title: "Tudo em dia numa lista só",
        description: "Os remédios vencidos aparecem primeiro, depois os que vencem em breve e os que estão em dia. Cada um mostra quantos dias faltam, e você busca qualquer remédio pelo nome.",
    },
    {
        title: "Fotografe a caixa",
        description: "Aponte a câmera para a caixa: o Pillo lê o nome, o código de barras, o registro e a validade. Você confere os dados e salva com um toque, ou digita à mão se preferir.",
    },
    {
        title: "Aviso antes de vencer",
        description: "Receba avisos 30 dias antes, 7 dias antes e no dia do vencimento, no horário que você escolher. Se o remédio vencer, o Pillo lembra uma vez por semana até você descartar.",
    },
    {
        title: "Entenda para que serve",
        description: "Um resumo da bula oficial da ANVISA em palavras simples: para que serve, como funciona, como usar e como guardar, com o link para a bula completa.",
    },
    {
        title: "Descarte do jeito certo",
        description: "Remédio vencido não vai para o lixo comum nem para a pia. O Pillo explica o que fazer e abre o Mapas para você encontrar um ponto de coleta.",
    },
    {
        title: "Simples e privado",
        description: "Sem conta e sem anúncios. Fotos, datas e avisos ficam no seu iPhone, e o Pillo acompanha o tamanho de texto que você usa no aparelho.",
    },
];

const useCases = [
    {
        title: "A farmacinha de casa",
        description: "Aquele remédio guardado para quando precisar não pega mais ninguém de surpresa: você sabe o que ainda vale e o que precisa trocar.",
    },
    {
        title: "Quem cuida de pais e avós",
        description: "Organize os remédios da família numa lista clara, com letras grandes e avisos antes de cada vencimento.",
    },
];

const faq = [
    {
        question: "O que é o Pillo?",
        answer: "O Pillo é um app para iPhone que organiza a validade dos remédios da sua casa. Você fotografa a caixa, confere os dados e o Pillo avisa antes de cada remédio vencer.",
    },
    {
        question: "Como o Pillo lê a caixa?",
        answer: "A câmera reconhece o texto e o código de barras da caixa no próprio iPhone. O Pillo encontra o nome, o registro e a validade e mostra tudo para você conferir antes de salvar. Se a leitura não der certo, dá para digitar os dados à mão.",
    },
    {
        question: "Quando recebo os avisos?",
        answer: "Por padrão, 30 dias antes, 7 dias antes e no dia do vencimento, no horário que você escolher nos Ajustes. Remédios vencidos podem receber um aviso por semana até você descartar. Os avisos chegam como notificação, mesmo com o app fechado.",
    },
    {
        question: "O Pillo funciona sem internet?",
        answer: "Sim, em grande parte. A leitura da caixa, a lista e os avisos funcionam sem internet. A busca das informações do remédio na ANVISA usa a conexão; sem internet, o remédio fica salvo e o Pillo completa as informações quando a conexão voltar.",
    },
    {
        question: "De onde vêm as informações dos remédios?",
        answer: "Da base pública da ANVISA: a lista de medicamentos, os Dados Abertos e o Bulário Eletrônico. O resumo é feito a partir da bula oficial, não indica dose nem tratamento e não substitui a orientação de um profissional de saúde. O Pillo não é afiliado à ANVISA.",
    },
    {
        question: "Meus dados ficam onde?",
        answer: "No seu iPhone. O Pillo não tem conta, não exibe anúncios e não usa estatísticas de uso. Para buscar as informações, ele envia só o código de barras, o registro ou o nome do remédio, sem nada que identifique você. Veja os detalhes na <a href=\"/pt-br/apps/pillo/privacy-policy/\">Política de Privacidade</a>.",
    },
    {
        question: "O que faço com um remédio vencido?",
        answer: "Não jogue no lixo comum, na pia ou no vaso sanitário. Leve a caixa a uma farmácia ou posto de saúde com ponto de coleta. No Pillo, toque em <em>Encontrar ponto de coleta</em> para abrir a busca no Mapas.",
    },
    {
        question: "Quanto custa e quando chega na App Store?",
        answer: "O Pillo é gratuito e sem anúncios. Ele chega em breve à App Store do Brasil, para iPhone com iOS 26 ou posterior.",
    },
];
---

<AppTemplate
    title={title}
    appName={appName}
    pageTitle={pageTitle}
    metas={metas}
    favicon={favicon}
    appIcon={appIcon}
    socialImage={socialImage}
    socialImageAlt={socialImageAlt}
    description={description}
    screenshots={screenshots}
    faq={faq}
    facts={facts}
    features={features}
    useCases={useCases}
    primaryKeyword={primaryKeyword}
    secondaryKeywords={secondaryKeywords}
    lang="pt-br"
    applicationCategory="HealthApplication"
/>
