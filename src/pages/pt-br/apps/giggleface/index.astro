---
import AppTemplate from "../../../../components/app/AppTemplate.astro";

const appName = "GiggleFace";
const title = "GiggleFace - Efeitos faciais em tempo real";
const pageTitle = "GiggleFace | Efeitos Faciais em Tempo Real para iPhone e Mac";
const description =
    "Dê vida a qualquer imagem com efeitos faciais personalizados. Use-os ao vivo, grave vídeos em até 60 fps com áudio e leve a diversão para chamadas no Mac — com processamento local.";
const favicon = "/apps/giggleface/favicon.png";
const appIcon = "giggleface/app-icon.png";
const socialImage = "/social/apps/giggleface-share-pt-br.jpg";
const socialImageAlt = "GiggleFace exibindo um efeito facial em tempo real com linhas luminosas de rastreamento do rosto.";
const testFlightUrl = "https://testflight.apple.com/join/GjXwReZf";

const screenshots = [
    {
        url: {
            en: "giggleface/screenshots/en/frame-1.png",
            ptBr: "giggleface/screenshots/ptBR/frame-1.png",
        },
        alt: "Prévias da câmera do GiggleFace com seis máscaras faciais personalizadas criadas a partir de imagens diferentes.",
        caption: "Transforme qualquer imagem em uma máscara personalizada que acompanha suas expressões ao vivo.",
    },
    {
        url: {
            en: "giggleface/screenshots/en/frame-2.png",
            ptBr: "giggleface/screenshots/ptBR/frame-2.png",
        },
        alt: "GiggleFace gravando um vídeo com uma máscara facial personalizada de palhaço.",
        caption: "Grave expressões fluidas e naturais com áudio em até 60 fps.",
    },
    {
        url: {
            en: "giggleface/screenshots/en/frame-3.png",
            ptBr: "giggleface/screenshots/ptBR/frame-3.png",
        },
        alt: "GiggleFace Camera no Mac emparelhando com um iPhone e recebendo um vídeo ao vivo com máscara.",
        caption: "Conecte-se ao GiggleFace no Mac e leve suas máscaras para videochamadas compatíveis.",
    },
    {
        url: {
            en: "giggleface/screenshots/en/frame-4.png",
            ptBr: "giggleface/screenshots/ptBR/frame-4.png",
        },
        alt: "Imagem sendo importada para o GiggleFace pelo menu de compartilhamento do iPhone.",
        caption: "Importe uma imagem da fototeca ou de outro app para criar uma máscara.",
    },
    {
        url: {
            en: "giggleface/screenshots/en/frame-5.png",
            ptBr: "giggleface/screenshots/ptBR/frame-5.png",
        },
        alt: "GiggleFace gravando offline com um efeito personalizado de máscara de hóquei.",
        caption: "Crie e grave offline enquanto suas imagens permanecem no dispositivo.",
    },
];

const facts = [
    { label: "Plataformas", value: "iPhone + Mac" },
    { label: "Compatibilidade", value: "iOS 26+ · macOS 26+" },
    { label: "Privacidade", value: "Processamento local" },
    { label: "Premium", value: "Compra única" },
];

const features = [
    {
        title: "Crie seu próprio efeito facial",
        description: "Com o GiggleFace Premium, transforme uma imagem da fototeca — ou compartilhada por outro app — em uma máscara exclusiva. Uma compra, sem assinatura.",
    },
    {
        title: "Veja tudo ganhar vida ao vivo",
        description: "Use máscaras que acompanham seu rosto em tempo real enquanto a imagem e os pontos faciais são processados diretamente no dispositivo.",
    },
    {
        title: "Ajuste até ficar do seu jeito",
        description: "Posicione, redimensione e encaixe cada máscara em um editor simples, feito para experimentar sem complicação.",
    },
    {
        title: "Compartilhe suas criações",
        description: "Exporte suas máscaras e envie pelo app que preferir usando o menu de compartilhamento, sem depender de um servidor do GiggleFace.",
    },
    {
        title: "Grave com fluidez e som",
        description: "Capture vídeos divertidos com efeitos faciais e áudio em até 60 fps nos dispositivos e configurações compatíveis.",
    },
    {
        title: "Leve o GiggleFace para as chamadas",
        description: "Use o GiggleFace como câmera virtual no Google Meet, Microsoft Teams, FaceTime e outros apps compatíveis no Mac.",
    },
];

const useCases = [
    {
        title: "Vire o personagem que imaginar",
        description: "Escolha uma imagem, crie sua máscara, ajuste o visual e veja o efeito acompanhar suas expressões ao vivo.",
    },
    {
        title: "Crie vídeos que fazem rir",
        description: "Grave momentos espontâneos com efeito facial, áudio e movimento fluido diretamente no seu dispositivo.",
    },
    {
        title: "Surpreenda em cada chamada",
        description: "Leve personagens e efeitos personalizados para conversas com amigos, família ou colegas usando a câmera virtual no Mac.",
    },
];

const faq = [
    {
        question: "O que é o GiggleFace?",
        answer: "O GiggleFace é um app criativo para iPhone e Mac que transforma imagens em efeitos faciais personalizados. Use máscaras ao vivo, grave vídeos com áudio e leve o resultado para apps de videochamada no macOS.",
    },
    {
        question: "O GiggleFace funciona offline?",
        answer: "Sim. Câmera, efeitos faciais, pontos de rastreamento e gravações são processados no dispositivo. A internet ainda pode ser necessária para TestFlight, compras e restaurações, conteúdo importado de serviços online, diagnósticos anônimos, compartilhamento por apps online e videochamadas.",
    },
    {
        question: "Como criar um efeito facial personalizado?",
        answer: "Com o <strong>GiggleFace Premium</strong>, escolha uma imagem da fototeca ou compartilhe uma de outro app. Depois, ajuste posição, escala e encaixe até a máscara ficar do seu jeito.",
    },
    {
        question: "Posso compartilhar máscaras com amigos?",
        answer: "Sim. Exporte o arquivo de máscara e escolha um app compatível pelo menu de compartilhamento do sistema. O GiggleFace não hospeda o arquivo em um servidor próprio de compartilhamento.",
    },
    {
        question: "O GiggleFace Premium é uma assinatura?",
        answer: "Não. O app é gratuito para baixar e o Premium é liberado com uma única compra, sem cobranças recorrentes.",
    },
    {
        question: "Quais apps no Mac aceitam o GiggleFace?",
        answer: "O GiggleFace funciona com apps do macOS compatíveis com câmeras virtuais, incluindo Google Meet, Microsoft Teams e FaceTime. A disponibilidade depende da versão do app, das permissões e da configuração do serviço.",
    },
    {
        question: "A gravação sempre funciona a 60 fps?",
        answer: "O GiggleFace grava em até 60 fps com áudio nos dispositivos compatíveis. A taxa real varia conforme hardware, temperatura, carga do sistema, ajustes e armazenamento disponível.",
    },
    {
        question: "O GiggleFace envia minha câmera ou minhas máscaras?",
        answer: "Não. Quadros da câmera, fotos, áudio, vídeos, máscaras e pontos faciais não são enviados para servidores de mídia do desenvolvedor. A Himetrica recebe somente diagnósticos limitados e anônimos, sem conteúdo de mídia ou campos de identidade pessoal.",
    },
];

const primaryKeyword = "efeitos faciais em tempo real";
const secondaryKeywords = [
    "máscaras faciais personalizadas",
    "app de câmera com efeitos",
    "efeitos faciais ao vivo",
    "câmera virtual para Mac",
    "efeitos para videochamadas",
    "gravação de vídeo a 60 fps",
    "app de máscara facial offline",
    "criador de máscaras faciais",
];
---

<AppTemplate
    appName={appName}
    title={title}
    pageTitle={pageTitle}
    metas={[]}
    favicon={favicon}
    appIcon={appIcon}
    socialImage={socialImage}
    socialImageAlt={socialImageAlt}
    description={description}
    screenshots={screenshots}
    faq={faq}
    facts={facts}
    features={features}
    useCases={useCases}
    testFlightUrl={testFlightUrl}
    termsOfUseUrl="/pt-br/apps/giggleface/terms-of-use"
    privacyPolicyUrl="/pt-br/apps/giggleface/privacy-policy"
    primaryKeyword={primaryKeyword}
    secondaryKeywords={secondaryKeywords}
    operatingSystem="iOS 26+, macOS 26+"
    lang="pt-br"
    applicationCategory="MultimediaApplication"
/>
