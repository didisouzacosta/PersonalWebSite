---
import AppTemplate from "../../../../components/app/AppTemplate.astro";

const title = "PotionPals: Water Sort";
const appName = "PotionPals";
const pageTitle = "PotionPals | Quebra-cabeça de separar cores para iPhone";
const description =
    "O clássico puzzle de separar cores ganha uma lojinha de poções cheia de vida. Despeje, separe as cores e entregue cada poção aos clientes fofinhos de gelatina.";
const favicon = "apps/potionpals/favicon.png";
const appIcon = "potionpals/app-icon.png";
const socialImage = "potionpals/potionpals-share-pt-br.jpg";
const socialImageAlt = "Ícone do app PotionPals com resumo do quebra-cabeça de separar cores.";

const metas: { name: string; content: string }[] = [];
const primaryKeyword = "separar cores";
const secondaryKeywords = [
    "water sort",
    "quebra-cabeça",
    "poção",
    "líquido",
    "frasco",
    "garrafa",
    "lógica",
    "relaxante",
    "puzzle",
    "gelatina",
    "mágico",
];

const screenshots = [
    {
        url: {
            en: "potionpals/screenshots/en/frame-1.jpg",
            ptBr: "potionpals/screenshots/ptBR/frame-1.jpg",
        },
        alt: "Home 3D do PotionPals com a logo, a loja de poções e os clientes de gelatina na frente do iPhone.",
        caption: "Clientes fofos esperando sua poção: 13 amiguinhos de gelatina.",
    },
    {
        url: {
            en: "potionpals/screenshots/en/frame-2.jpg",
            ptBr: "potionpals/screenshots/ptBR/frame-2.jpg",
        },
        alt: "Nível do PotionPals com clientes de gelatina no balcão, frascos sendo separados por cor e o Mestre Pingo.",
        caption: "Despeje, combine e vicie-se! Separe as cores e encha cada poção.",
    },
    {
        url: {
            en: "potionpals/screenshots/en/frame-3.jpg",
            ptBr: "potionpals/screenshots/ptBR/frame-3.jpg",
        },
        alt: "Nível muito difícil do PotionPals com frascos de tamanhos diferentes e o selo de 300 fases.",
        caption: "Fácil de começar, impossível de parar, com 300 fases cada vez mais difíceis.",
    },
    {
        url: {
            en: "potionpals/screenshots/en/frame-4.jpg",
            ptBr: "potionpals/screenshots/ptBR/frame-4.jpg",
        },
        alt: "Mapa do modo História do PotionPals com ilhas flutuantes, portões, estrelas e o selo de 13 capítulos.",
        caption: "Modo História: um mundo mágico de ilhas flutuantes, portões e estrelas.",
    },
    {
        url: {
            en: "potionpals/screenshots/en/frame-5.jpg",
            ptBr: "potionpals/screenshots/ptBR/frame-5.jpg",
        },
        alt: "Desafio difícil do modo Challenger do PotionPals com cortina, cor misteriosa e o selo de 100 desafios.",
        caption: "Modo Challenger: você dá conta? 100 desafios e só 3 Desfazer.",
    },
    {
        url: {
            en: "potionpals/screenshots/en/frame-6.jpg",
            ptBr: "potionpals/screenshots/ptBR/frame-6.jpg",
        },
        alt: "Card de nível concluído do modo Casual do PotionPals com 22 movimentos no saldo.",
        caption: "Modo Casual: até onde você vai? Ganhe movimentos a cada poção.",
    },
    {
        url: {
            en: "potionpals/screenshots/en/frame-7.jpg",
            ptBr: "potionpals/screenshots/ptBR/frame-7.jpg",
        },
        alt: "Partida do modo Endurance do PotionPals com pontos, multiplicador de combo e o relógio da jogada.",
        caption: "Modo Endurance: quanto você aguenta? Combos de até ×5 contra o relógio.",
    },
    {
        url: {
            en: "potionpals/screenshots/en/frame-8.jpg",
            ptBr: "potionpals/screenshots/ptBR/frame-8.jpg",
        },
        alt: "Nível noturno do PotionPals com cortinas e cadeados escondendo os frascos e o selo de novas mecânicas.",
        caption: "Uma surpresa nova a cada capítulo: cortinas, cadeados e mistérios.",
    },
];

const facts = [
    { label: "Plataforma", value: "iPhone · iOS 26+" },
    { label: "Fases", value: "300 em 13 capítulos" },
    { label: "Modos de jogo", value: "História, Casual, Endurance, Challenger" },
    { label: "Idiomas", value: "Português, inglês, espanhol, francês e japonês" },
];

const features = [
    {
        title: "Quatro modos de jogo",
        description: "Atravesse 300 fases da História num mapa 3D, vá o mais longe possível no Casual, bata seu recorde no Endurance ou encare 100 desafios de final de partida no Challenger.",
    },
    {
        title: "Resgate os amigos do Mestre Pingo",
        description: "Uma poção feita com pressa espalhou os 12 amigos do Mestre Pingo pelo mapa. Encontre cada um antes de um portão, numa história contada em quadrinhos, e veja quem já voltou para casa.",
    },
    {
        title: "Uma surpresa nova a cada capítulo",
        description: "Frascos colecionadores, cortinas, cadeados, cores misteriosas e frascos de tamanhos diferentes deixam cada capítulo mais desafiador, com até 12 cores para separar.",
    },
    {
        title: "Feito com capricho",
        description: "Despejos fluidos com háptica e sons, backup automático no iCloud, placares e conquistas do Game Center, além de modo daltônico, Reduzir Movimento, Aumentar Contraste e Texto Dinâmico.",
    },
];

const useCases = [
    {
        title: "Pausas curtas e relaxantes",
        description: "Um quebra-cabeça satisfatório para jogar com uma mão em poucos minutos, com uma gota de estratégia e zero pressa.",
    },
    {
        title: "Fãs de separar cores",
        description: "O clássico puzzle de separar líquidos num mundo colorido, com uma loja de poções viva, um mapa-mundo em 3D e desafios para quem quer ir além.",
    },
];

const faq = [
    {
        question: "O que é o PotionPals?",
        answer: "PotionPals: Water Sort é um jogo casual de separar cores e líquidos para iPhone. Numa loja de poções feita de gelatina, clientes fofinhos fazem fila no balcão esperando o seu elixir, e cabe a você arrumar os frascos misturados.",
    },
    {
        question: "Como jogar?",
        answer: "Toque num frasco e depois em outro para despejar o líquido do topo. Só dá para despejar sobre a mesma cor, e se houver espaço. Quando um frasco fica com uma cor só, ele é arrolhado e voa para quem pediu. Travou? Use a <strong>dica</strong>, <strong>desfaça</strong> a jogada ou peça um <strong>frasco extra</strong>.",
    },
    {
        question: "Quais são os modos de jogo?",
        answer: "<strong>História</strong>: 300 fases em 13 capítulos num mapa 3D de ilhas flutuantes, com portões abertos pelas estrelas e os amigos do Mestre Pingo para resgatar. <strong>Casual</strong>: siga de fase em fase com um saldo de movimentos, e cada poção completa devolve movimentos. <strong>Endurance</strong>: um tabuleiro que nunca acaba, com combos de até ×5 e um relógio a cada jogada. <strong>Challenger</strong>: 100 desafios de final de partida, do fácil ao muito difícil, sem dica e sem frasco extra, só com 3 Desfazer.",
    },
    {
        question: "O que são energia, moedas e boosters?",
        answer: "Cada fase, corrida ou desafio usa uma energia, que se recarrega com o tempo. Você ganha estrelas e moedas jogando, além da recompensa diária e da sequência de vitórias. Moedas e boosters como dica, desfazer e frasco extra também podem ser comprados no app, de forma opcional, assim como a <strong>Energia Infinita</strong>.",
    },
    {
        question: "Como restauro minhas compras?",
        answer: "A <strong>Energia Infinita</strong> é uma compra única vinculada à sua Conta Apple. Se reinstalar o app ou trocar de aparelho, toque em <em>Restaurar compras</em> na loja ou nos ajustes do jogo e ela será verificada pela sua Conta Apple, sem custo adicional. Moedas e pacotes de boosters são consumíveis e se esgotam conforme você joga.",
    },
    {
        question: "Perco meu progresso se trocar de iPhone?",
        answer: "Não, se o iCloud estiver ativo. O jogo é guardado sozinho no seu iCloud, com fases, estrelas, desafios, recordes, moedas e boosters. No aparelho novo, abra os ajustes do jogo e toque em <em>Restaurar backup do iCloud</em>.",
    },
    {
        question: "Preciso do Game Center?",
        answer: "Não. Os placares e as conquistas do Game Center são opcionais. Sem fazer login, você continua jogando normalmente e o progresso fica salvo no seu iPhone e no seu iCloud.",
    },
    {
        question: "Como participo do teste beta?",
        answer: "O PotionPals está aberto para testes pelo TestFlight. Instale o app TestFlight no iPhone, toque em <strong>Entrar no TestFlight</strong> nesta página e aceite o convite. Sugestões e problemas podem ser enviados pelo próprio TestFlight.",
    },
    {
        question: "O PotionPals tem acessibilidade?",
        answer: "Sim. O PotionPals tem modo daltônico e suporta Reduzir Movimento, Aumentar Contraste e Texto Dinâmico.",
    },
];
---

<AppTemplate
    testFlightUrl="https://testflight.apple.com/join/Z3zPD8qJ"
    title={title}
    appName={appName}
    pageTitle={pageTitle}
    metas={metas}
    favicon={favicon}
    appIcon={appIcon}
    socialImage={socialImage}
    socialImageAlt={socialImageAlt}
    description={description}
    screenshots={screenshots}
    faq={faq}
    facts={facts}
    features={features}
    useCases={useCases}
    primaryKeyword={primaryKeyword}
    secondaryKeywords={secondaryKeywords}
    lang="pt-br"
    applicationCategory="GameApplication"
/>
