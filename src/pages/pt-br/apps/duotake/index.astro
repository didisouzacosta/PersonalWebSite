];
---

<AppTemplate
    title={title}
    appId={appId}
    appStoreUrl={appStoreUrl}
    appName={appName}
    pageTitle={pageTitle}
    metas={metas}
    favicon={favicon}
    appIcon={appIcon}
    socialImage={socialImage}
    socialImageAlt={socialImageAlt}
    description={description}
    screenshots={screenshots}
    faq={faq}
    facts={facts}
    features={features}
    useCases={useCases}
    primaryKeyword={primaryKeyword}
    secondaryKeywords={secondaryKeywords}
    termsOfUseUrl="/pt-br/apps/duotake/terms-of-use/"
    privacyPolicyUrl="/pt-br/apps/duotake/privacy-policy/"
    lang="pt-br"
    operatingSystem="iOS 26.6 or later"
    applicationCategory="MultimediaApplication"
/>
