---
import AppTemplate from "../../../../components/app/AppTemplate.astro";

const title = "Câmera dupla: DuoTake";
const appId = "id6761627384";
const appStoreUrl = "https://apps.apple.com/br/app/dual-camera-duotake/id6761627384";
const appName = "DuoTake";
const pageTitle = "Câmera dupla: DuoTake";
const description =
    "Tela dividida e teleprompter";
const favicon = "apps/duotake/favicon.png";
const appIcon = "duotake/app-icon.png";
const socialImage = "duotake/duotake-share-pt-br.jpg";
const socialImageAlt = "Ícone do app DuoTake com resumo do app de câmera de reação.";

const metas = [{ name: "apple-itunes-app", content: "app-id=6761627384" }];
const primaryKeyword = "câmera de reação";
const secondaryKeywords = [
    "react video",
    "captura de fotos e vídeos",
    "frontal traseira",
    "teleprompter",
    "gravação com roteiro",
    "criador conteudo",
    "gravar video",
    "TikTok Reels Shorts",
];

const screenshots = [
    {
        url: {
            en: "duotake/screenshots/en/frame-1.png",
            ptBr: "duotake/screenshots/ptBR/frame-1.png",
        },
        alt: "Prévia do Cutout no DuoTake mostrando uma reação com recorte automático sobre a câmera em tela cheia.",
        caption: "Use o Cutout para manter sua reação limpa com remoção automática de fundo.",
    },
    {
        url: {
            en: "duotake/screenshots/en/frame-2.png",
            ptBr: "duotake/screenshots/ptBR/frame-2.png",
        },
        alt: "Tela de gravação com câmera dupla do DuoTake mostrando uma paisagem de montanha com selfie em sobreposição.",
        caption: "Mostre o momento e sua expressão juntos em uma única gravação.",
    },
    {
        url: {
            en: "duotake/screenshots/en/frame-3.png",
            ptBr: "duotake/screenshots/ptBR/frame-3.png",
        },
        alt: "Layout Cover do DuoTake mostrando uma cena de piquenique em tela cheia com selfie de grupo em sobreposição.",
        caption: "Use o Cover para destacar uma câmera em tela cheia mantendo a outra em sobreposição.",
    },
    {
        url: {
            en: "duotake/screenshots/en/frame-4.png",
            ptBr: "duotake/screenshots/ptBR/frame-4.png",
        },
        alt: "Tela do Teleprompter do DuoTake com roteiro sobreposto à imagem da câmera durante a gravação.",
        caption: "Acompanhe seu roteiro na tela com o Teleprompter premium enquanto grava.",
    },
    {
        url: {
            en: "duotake/screenshots/en/frame-5.png",
            ptBr: "duotake/screenshots/ptBR/frame-5.png",
        },
        alt: "Layout de câmera de reação dupla do DuoTake gravando câmeras frontal e traseira ao mesmo tempo.",
        caption: "Grave as câmeras frontal e traseira juntas em um layout de creator com duas visões.",
    },
    {
        url: {
            en: "duotake/screenshots/en/frame-6.png",
            ptBr: "duotake/screenshots/ptBR/frame-6.png",
        },
        alt: "Gravação de reação ao vivo no DuoTake em um estádio com câmera de reação em sobreposição.",
        caption: "Apareça junto do momento com uma sobreposição de reação ao vivo.",
    },
];

const facts = [
    { label: "Plataforma", value: "iPhone" },
    { label: "Versão", value: "1.3.1" },
    { label: "Ideal para", value: "Creators, reviews e reacts" },
    { label: "Requer", value: "iOS 26.6 ou posterior" },
];

const features = [
    {
        title: "Fotos e vídeos com duas visões",
        description: "Capture a cena e sua reação juntas usando as duas câmeras do iPhone.",
    },
    {
        title: "Reaja a conteúdo importado com Pro",
        description: "Substitua a visão traseira por uma imagem, vídeo ou página capturada de uma URL HTTPS.",
    },
    {
        title: "Quatro estilos de layout",
        description: "Componha sua captura com PiP, Cover, tela dividida na vertical ou horizontal ou Cutout.",
    },
    {
        title: "Teleprompter premium",
        description: "Mantenha um roteiro visível durante a gravação de vídeo.",
    },
    {
        title: "Galeria local",
        description: "Revise as capturas no dispositivo, salve no Fotos ou escolha um destino no compartilhamento do sistema.",
    },
    {
        title: "Grátis e Pro",
        description: "Grave até 60 segundos grátis. O Pro oferece gravações mais longas, salvamento automático no Fotos e compartilhamento sem a marca d’água temporária.",
    },
];

const useCases = [
    {
        title: "Registre tudo. Inclusive sua reação.",
        description: "Com o DuoTake, você grava usando a câmera frontal e traseira ao mesmo tempo, mostrando o que está acontecendo e como você reage em um único vídeo.",
    },
    {
        title: "Grave com roteiro",
        description: "Use o Teleprompter premium para apresentações, reviews, tutoriais, vlogs e reações com roteiro sem desviar o olhar da câmera.",
    },
];

const faq = [
    {
        question: "O que é DuoTake?",
        answer: "DuoTake é um app de câmera dupla para gravar com a câmera frontal e traseira ao mesmo tempo. Ele ajuda você a capturar o momento, sua voz, seu roteiro e sua reação em um vídeo composto.",
    },
    {
        question: "Para quem o DuoTake foi feito?",
        answer: "O DuoTake foi feito para creators, reviews de produtos, reacts, comentários, tutoriais, vlogs, eventos, viagens e qualquer pessoa que quer mostrar o momento e sua reação ao mesmo tempo.",
    },
    {
        question: "Posso reagir a imagens, vídeos ou páginas da web?",
        answer: "Sim. O Pro permite importar uma imagem, vídeo ou página HTTPS no lugar da visão da câmera traseira. Use apenas conteúdo que você tenha permissão para gravar e compartilhar.",
    },
    {
        question: "O DuoTake tem remoção de fundo?",
        answer: "Sim. O DuoTake inclui remoção de fundo com Cutout para deixar sua reação mais limpa, focada e fácil de combinar com o momento que você está gravando.",
    },
    {
        question: "O DuoTake tem Teleprompter?",
        answer: "Sim. Usuários premium podem usar o Teleprompter para escrever ou colar um roteiro, acompanhar o texto durante a captura e gravar apresentações, reviews, tutoriais, vlogs e reações com mais naturalidade.",
    },
    {
        question: "O DuoTake funciona offline?",
        answer: "A captura pelas câmeras e o processamento local funcionam no dispositivo. Carregar uma página da web, comprar e restaurar compras exigem internet. Salvar no Fotos requer permissão.",
    },
    {
        question: "Como restaurar minha compra?",
        answer: "Se você já desbloqueou os recursos premium do DuoTake, toque em <em>Restaurar Compras</em> e o app pedirá à Apple para validar sua compra anterior com o mesmo Apple ID — sem custo extra.",
    },
];
---

<AppTemplate
    title={title}
    appId={appId}
    appStoreUrl={appStoreUrl}
    appName={appName}
    pageTitle={pageTitle}
    metas={metas}
    favicon={favicon}
    appIcon={appIcon}
    socialImage={socialImage}
    socialImageAlt={socialImageAlt}
    description={description}
    screenshots={screenshots}
    faq={faq}
    facts={facts}
    features={features}
    useCases={useCases}
    primaryKeyword={primaryKeyword}
    secondaryKeywords={secondaryKeywords}
    termsOfUseUrl="/pt-br/apps/duotake/terms-of-use/"
    privacyPolicyUrl="/pt-br/apps/duotake/privacy-policy/"
    lang="pt-br"
    operatingSystem="iOS 26.6 or later"
    applicationCategory="MultimediaApplication"
/>
