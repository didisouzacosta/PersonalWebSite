---
import Layout from "../../../src/layouts/Layout.astro";
import { duoTakeFavicon, duoTakeSiteChrome } from "../../../src/core/apps/duotake";
import { duoTakeSiteUrl } from "../../../src/core/seo";
---

<Layout
    title="Page not found – DuoTake"
    lang="en"
    favicon={duoTakeFavicon}
    robots="noindex, follow"
    canonicalUrl={`${duoTakeSiteUrl}/`}
    alternateLanguageHref="/pt-br/"
    analyticsPageType="system"
    analyticsProjectSlug="duotake"
    {...duoTakeSiteChrome("en")}
>
    <main>
        <h1>Page not found</h1>
        <p>The page you are looking for does not exist.</p>
        <p><a href="/">DuoTake</a> · <a href="/pt-br/" lang="pt-BR">Português</a></p>
    </main>
</Layout>

<style>
    main {
        max-width: 780px;
        margin: 0 auto;
        padding: calc(120px + var(--safe-area-top)) var(--safe-page-padding-right) calc(64px + var(--safe-area-bottom)) var(--safe-page-padding-left);
        text-align: center;
    }

    h1 {
        margin-bottom: 16px;
    }

    p {
        margin-bottom: 12px;
        color: var(--text-secondary);
    }

    a {
        text-decoration: underline;
        text-underline-offset: 3px;
    }
</style>
